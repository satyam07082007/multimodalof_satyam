# ==============================================================
# HAVEN AI - MULTIMODAL INTELLIGENT ASSISTANT (.env)
# "One AI. Every Possibility."
# ==============================================================

# AI Providers & Model Configuration
# 1. Google Gemini (For general conversational intelligence & vision analysis)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# 2. Hugging Face Inference API (Optional, for open-source LLMs & FLUX/SDXL image diffusion)
HUGGINGFACE_API_KEY=your_huggingface_token_here
HF_LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Application Host & Ports
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
BACKEND_URL=http://127.0.0.1:8000
ALLOWED_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# MySQL Database (Optional - falls back automatically to local SQLite for instant zero-config testing)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=emotional_support_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# RAG & Embeddings
EMBEDDING_MODEL=tfidf_semantic
VECTOR_STORE_PATH=./data/vector_index.json
SIMILARITY_THRESHOLD=0.1
TOP_K_RETRIEVAL=3

# Safety Guardrails
ENABLE_STRICT_GUARDRAILS=true
CRISIS_HELPLINE_PHONE=988
CRISIS_TEXT_LINE=Text HOME to 741741
MAX_UPLOAD_SIZE_MB=25
